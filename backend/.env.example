# Copy to .env for local overrides. Never commit .env.

# SQLite fallback (no setup). Docker Compose uses PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://ahi:ahi@localhost:5432/ahi
DATABASE_URL=sqlite:///./ahi.db
AUTO_MIGRATE=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5183,http://127.0.0.1:5183
LOG_LEVEL=INFO

# Public NASA sources, no API key needed.
DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI/WS/get
OSDR_BASE_URL=https://osdr.nasa.gov
HTTP_TIMEOUT_SECONDS=20
NASA_CACHE_TTL_SECONDS=900

# Assistant (demo only). A cloud model is NOT acceptable on a real mission: see docs/assistant-architecture.md.
# Without a key the assistant answers 503 "assistant not configured" and the web app shows "Assistant offline".
# Put the real key only in backend/.env (gitignored). Never commit it.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_MAX_TOKENS=1500
ASSISTANT_EFFORT=low
ASSISTANT_REFUSAL_FALLBACK=true
ASSISTANT_TIMEOUT_SECONDS=60
ASSISTANT_RATE_LIMIT_PER_MINUTE=6
ASSISTANT_RATE_LIMIT_PER_HOUR=60
